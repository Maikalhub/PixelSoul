--- !u!114 &8430996
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8430994}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dfd751fefe0590f479c99c903d3307c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  playerTag: Player
  interactKey: 116
  closeKey: 27
  closeSprite: {fileID: 972067183}
  interactionSprite: {fileID: 1467903350}
  canvasObject: {fileID: 509597297}
  textObject: {fileID: 509597299}
  messages:
  - text: "So\u2026 you have reached the heart of the castle.\n\nHow curious.\n\nBone
      by bone, step by step, you have dragged yourself through ruin, blood, and silence.\nYou
      have taken the keys.\nYou have crossed the trials.\nYou have survived the halls
      that were meant to bury you forever.\n\nAnd now, at last, the castle opens
      its final wound.\n\nBeyond this gate waits the one who has been listening to
      every step you took.\nThe one who watched you fall, rise, and fall again.\nThe
      one who knows why death returned you to these cursed stones."
    continueKey: 306
    continueSprite: {fileID: 208526939}
    overrideTextSettings: 1
    textAlignment: 513
    fontSize: 30
    textColor: {r: 1, g: 1, b: 1, a: 1}
    overrideTextRectTransform: 1
    anchoredPosition: {x: 0, y: 40}
    sizeDelta: {x: 1200, y: 400}
  - text: "Do not expect mercy.\nDo not expect answers freely given.\n\nThe thing
      that waits below does not guard the castle.\nIt is the castle\u2019s will made
      flesh, bone, and hatred.\n\nIf you defeat it, perhaps the truth will finally
      crawl out from the dark.\nIf you fail, your bones will join the rest beneath
      this throne.\n\nGo on, wandering bone.\nThe castle is silent now.\n\nIt wants
      to hear you break."
    continueKey: 308
    continueSprite: {fileID: 972067183}
    overrideTextSettings: 1
    textAlignment: 513
    fontSize: 30
    textColor: {r: 1, g: 1, b: 1, a: 1}
    overrideTextRectTransform: 1
    anchoredPosition: {x: 0, y: 100}
    sizeDelta: {x: 1200, y: 400}
  useTypingEffect: 1
  typingSpeed: 0.02
  canInteractAgain: 1
  repeatDelay: 0
  closeOnExit: 1
  hideInteractionSpriteWhileTextOpen: 1
  allowContinueOnlyAfterTyping: 1
  pressContinueKeyToSkipTyping: 1
  closeAfterLastMessage: 1
  allowCloseOnlyAfterTyping: 1
  pressCloseKeyToSkipTyping: 1
  showCloseSpriteWhileDialogueOpen: 1
  showCloseSpriteOnlyAfterTyping: 1
