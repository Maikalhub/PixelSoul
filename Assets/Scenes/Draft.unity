  m_GameObject: {fileID: 1423265050}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dfd751fefe0590f479c99c903d3307c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  playerTag: Player
  interactKey: 116
  closeKey: 27
  closeSprite: {fileID: 972067183}
  interactionSprite: {fileID: 615611689}
  canvasObject: {fileID: 509597297}
  textObject: {fileID: 509597299}
  messages:
  - text: "If you are reading this, wandering bone\u2026 then I misjudged you.\n\nYou
      have crossed the first threshold.\nYou have walked where others collapsed,
      endured what should have scattered your bones across the cold stone floor.\n\nPerhaps
      there is more left within you than dust and silence.\n\nBut do not mistake
      survival for victory.\n\nThe next trial will not test whether you can rise.\nIt
      will test how many times you can fall before even death grows tired of watching."
    continueKey: 306
    continueSprite: {fileID: 208526939}
    overrideTextSettings: 1
    textAlignment: 513
    fontSize: 30
    textColor: {r: 1, g: 1, b: 1, a: 1}
    overrideTextRectTransform: 1
    anchoredPosition: {x: 0, y: 40}
    sizeDelta: {x: 1200, y: 400}
  - text: "Here, the castle will show no mercy.\nSteel will bite.\nLight will burn.\nThe
      dead will reach for you from the dark, eager to drag you back into the grave
      you escaped.\n\nAnd when this place is done with you, stranger\u2026\nI will
      forget your name.\n\nThough perhaps I never knew it at all.\n\nStep forward,
      bone wanderer.\nLet us see what remains of you when the castle stops holding
      back."
    continueKey: 308
    continueSprite: {fileID: 972067183}
    overrideTextSettings: 1
    textAlignment: 513
    fontSize: 30
    textColor: {r: 1, g: 1, b: 1, a: 1}
    overrideTextRectTransform: 1
    anchoredPosition: {x: 0, y: 100}
    sizeDelta: {x: 1200, y: 400}
  useTypingEffect: 1
  typingSpeed: 0.02
  canInteractAgain: 1
  repeatDelay: 0
  closeOnExit: 1
  hideInteractionSpriteWhileTextOpen: 1
  allowContinueOnlyAfterTyping: 1
  pressContinueKeyToSkipTyping: 1
  closeAfterLastMessage: 1
  allowCloseOnlyAfterTyping: 1
  pressCloseKeyToSkipTyping: 1
  showCloseSpriteWhileDialogueOpen: 1
  showCloseSpriteOnlyAfterTyping: 1
