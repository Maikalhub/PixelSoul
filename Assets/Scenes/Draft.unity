--- !u!114 &1412108925
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1412108923}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dfd751fefe0590f479c99c903d3307c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  playerTag: Player
  interactKey: 116
  closeKey: 27
  closeSprite: {fileID: 972067183}
  interactionSprite: {fileID: 824567156}
  canvasObject: {fileID: 509597297}
  textObject: {fileID: 509597299}
  messages:
  - text: "The darkness of the labyrinth suddenly grows thicker \u2014 it presses
      against your hollow sockets, seeps into the cracks of your ancient bones. Somewhere
      ahead, behind, everywhere at once, comes the rustle of footsteps that cannot
      exist. "
    continueKey: 306
    continueSprite: {fileID: 208526939}
    overrideTextSettings: 1
    textAlignment: 513
    fontSize: 30
    textColor: {r: 1, g: 1, b: 1, a: 1}
    overrideTextRectTransform: 1
    anchoredPosition: {x: 0, y: 40}
    sizeDelta: {x: 1200, y: 400}
  - text: "A chuckle. Lazy, self-satisfied.  Red: \"Let's see how you handle the
      maze, wandering bone. No map, no guiding star \u2014 just cold stone that's
      forgotten its own name, and shadows that forgot how to sleep long ago. Every
      turn here is a question with no answer; every corridor is a noose around a
      luckless dead man's neck. You're already dead \u2014 but that doesn't mean
      you've got nothing left to lose. Oblivion is far worse than death, isn't it? "
    continueKey: 306
    continueSprite: {fileID: 208526939}
    overrideTextSettings: 1
    textAlignment: 513
    fontSize: 30
    textColor: {r: 1, g: 1, b: 1, a: 1}
    overrideTextRectTransform: 1
    anchoredPosition: {x: 0, y: 40}
    sizeDelta: {x: 1200, y: 400}
  - text: "This labyrinth remembers everyone who walked in with their head held high\u2026
      but it doesn't remember a single one who walked out. Do you have enough will
      left not to become just another whisper in these walls? Or will you wander
      in circles until you crumble to dust, forgetting why you ever crawled out of
      your grave? Don't go silent on me. Creak. Resist. Entertain me\u2026 bag of
      bones.\""
    continueKey: 306
    continueSprite: {fileID: 208526939}
    overrideTextSettings: 1
    textAlignment: 513
    fontSize: 30
    textColor: {r: 1, g: 1, b: 1, a: 1}
    overrideTextRectTransform: 1
    anchoredPosition: {x: 0, y: 40}
    sizeDelta: {x: 1200, y: 400}
  useTypingEffect: 1
  typingSpeed: 0.02
  canInteractAgain: 1
  repeatDelay: 0
  closeOnExit: 1
  hideInteractionSpriteWhileTextOpen: 1
  allowContinueOnlyAfterTyping: 1
  pressContinueKeyToSkipTyping: 1
  closeAfterLastMessage: 1
  allowCloseOnlyAfterTyping: 1
  pressCloseKeyToSkipTyping: 1
  showCloseSpriteWhileDialogueOpen: 1
  showCloseSpriteOnlyAfterTyping: 1
