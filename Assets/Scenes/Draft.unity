--- !u!114 &1561188250
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1561188248}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dfd751fefe0590f479c99c903d3307c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  playerTag: Player
  interactKey: 116
  closeKey: 27
  closeSprite: {fileID: 972067183}
  interactionSprite: {fileID: 115281229}
  canvasObject: {fileID: 509597297}
  textObject: {fileID: 509597299}
  messages:
  - text: "Your first trial awaits, wandering bone\u2026\n\nThe castle does not open
      its deeper halls to the weak.\nBefore you may descend further, it has prepared
      a trial to measure what remains of your strength, your will, and whatever memory
      still clings to your bones.\n\nAcross these cursed chambers, you will find
      strange relics of power \u2014 ancient coins marked by forgotten magic.\nClaim
      them, and for a brief moment, your hollow body may move faster, strike harder,
      endure longer, or mend what little life still binds you to this world."
    continueKey: 306
    continueSprite: {fileID: 208526939}
    overrideTextSettings: 1
    textAlignment: 513
    fontSize: 30
    textColor: {r: 1, g: 1, b: 1, a: 1}
    overrideTextRectTransform: 1
    anchoredPosition: {x: 0, y: 40}
    sizeDelta: {x: 1200, y: 400}
  - text: "But you will not walk alone.\n\nThe dead still serve these halls.\nCursed
      guards, restless beasts, and things that should have stayed buried are already
      waiting in the dark.\nThey hunger for the sound of your bones breaking.\n\nDefeat
      them, and they may leave behind precious gems \u2014 fragments of old power,
      wealth, or memory.\nGather what you can. Nothing in this castle is given without
      blood."
    continueKey: 306
    continueSprite: {fileID: 208526939}
    overrideTextSettings: 1
    textAlignment: 513
    fontSize: 30
    textColor: {r: 1, g: 1, b: 1, a: 1}
    overrideTextRectTransform: 1
    anchoredPosition: {x: 0, y: 40}
    sizeDelta: {x: 1200, y: 400}
  - text: 'Your true task is simple, yet dangerous:


      Find every key hidden
      within this level.

      Only then will the enchanted door awaken and grant
      passage to the next chamber of the castle.


      Step carefully, bone wanderer.

      The
      trial has begun.'
    continueKey: 306
    continueSprite: {fileID: 972067183}
    overrideTextSettings: 1
    textAlignment: 513
    fontSize: 30
    textColor: {r: 1, g: 1, b: 1, a: 1}
    overrideTextRectTransform: 1
    anchoredPosition: {x: 0, y: 40}
    sizeDelta: {x: 1200, y: 400}
  useTypingEffect: 1
  typingSpeed: 0.02
  canInteractAgain: 1
  repeatDelay: 0
  closeOnExit: 1
  hideInteractionSpriteWhileTextOpen: 1
  allowContinueOnlyAfterTyping: 1
  pressContinueKeyToSkipTyping: 1
  closeAfterLastMessage: 1
  allowCloseOnlyAfterTyping: 1
  pressCloseKeyToSkipTyping: 1
  showCloseSpriteWhileDialogueOpen: 1
  showCloseSpriteOnlyAfterTyping: 1
