  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dfd751fefe0590f479c99c903d3307c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  playerTag: Player
  interactKey: 116
  closeKey: 27
  closeSprite: {fileID: 972067183}
  interactionSprite: {fileID: 1127140774}
  canvasObject: {fileID: 509597297}
  textObject: {fileID: 509597299}
  messages:
  - text: "\"So you\u2019ve come seeking a meeting, bag of bones? How dutiful. How
      naive. You think you understand what awaits you \u2014 you think you\u2019ve
      braved enough dark corners and silent halls to stand before me as something
      more than carrion. But there is no meeting without unveiling, and you are still
      wrapped in the comfortable lies you tell yourself. I don\u2019t test your strength;
      the grave already took that. I test your clarity. Are you ready to see what
      you truly are beneath that stubborn will? Or will you shatter the moment my
      light touches the one memory you buried deepest? Don\u2019t step forward yet
      \u2014 answer. Or let your jaw hang slack in terror. Either way, you\u2019re
      already on my scale\u2026 bag of bones.\""
    continueKey: 308
    continueSprite: {fileID: 972067183}
    overrideTextSettings: 1
    textAlignment: 513
    fontSize: 30
    textColor: {r: 1, g: 1, b: 1, a: 1}
    overrideTextRectTransform: 1
    anchoredPosition: {x: 0, y: 100}
    sizeDelta: {x: 1200, y: 400}
  useTypingEffect: 1
  typingSpeed: 0.02
  canInteractAgain: 1
  repeatDelay: 0
  closeOnExit: 1
  hideInteractionSpriteWhileTextOpen: 1
  allowContinueOnlyAfterTyping: 1
  pressContinueKeyToSkipTyping: 1
  closeAfterLastMessage: 1
  allowCloseOnlyAfterTyping: 1
  pressCloseKeyToSkipTyping: 1
  showCloseSpriteWhileDialogueOpen: 1
  showCloseSpriteOnlyAfterTyping: 1
