--- !u!114 &1724370979
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1724370977}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dfd751fefe0590f479c99c903d3307c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  playerTag: Player
  interactKey: 116
  closeKey: 27
  closeSprite: {fileID: 972067183}
  interactionSprite: {fileID: 695755702}
  canvasObject: {fileID: 509597297}
  textObject: {fileID: 509597299}
  messages:
  - text: "Welcome, wandering bone\u2026\n\nYou awaken deep within an ancient castle,
      where the stones remember blood and the shadows whisper the names of those
      who never escaped.\n\nOnce, you may have been a warrior, a prisoner, or perhaps
      even a king. Now, only your bones remain \u2014 and a cold will to move forward."
    continueKey: 306
    continueSprite: {fileID: 208526939}
    overrideTextSettings: 1
    textAlignment: 513
    fontSize: 30
    textColor: {r: 1, g: 1, b: 1, a: 1}
    overrideTextRectTransform: 1
    anchoredPosition: {x: 0, y: 40}
    sizeDelta: {x: 1200, y: 400}
  - text: "Behind rusted gates, traps await.\nIn the towers, cursed guards still
      roam.\nAnd somewhere in the heart of the castle, a light still burns \u2014
      one that should not have survived the night.\n\nRise from the dust.\nGather
      the fragments of your memory.\nDiscover why death has not released you.\n\nBegin
      your journey, bone wanderer. The castle already hears your steps."
    continueKey: 308
    continueSprite: {fileID: 972067183}
    overrideTextSettings: 1
    textAlignment: 513
    fontSize: 30
    textColor: {r: 1, g: 1, b: 1, a: 1}
    overrideTextRectTransform: 1
    anchoredPosition: {x: 0, y: 100}
    sizeDelta: {x: 1200, y: 400}
  useTypingEffect: 1
  typingSpeed: 0.02
  canInteractAgain: 1
  repeatDelay: 0
  closeOnExit: 1
  hideInteractionSpriteWhileTextOpen: 1
  allowContinueOnlyAfterTyping: 1
  pressContinueKeyToSkipTyping: 1
  closeAfterLastMessage: 1
  allowCloseOnlyAfterTyping: 1
  pressCloseKeyToSkipTyping: 1
  showCloseSpriteWhileDialogueOpen: 1
  showCloseSpriteOnlyAfterTyping: 1
